# Cloudflare Pages reads this file from the root of the deployed directory.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# The screenshots are regenerated by the Playwright specs in
# frontend/e2e/docs/, so they change under a stable filename. A long cache with
# revalidation keeps them fast without serving last release's picture.
/docs/assets/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# mkdocs fingerprints its own bundles, so these are safe to pin.
/docs/assets/javascripts/*
  Cache-Control: public, max-age=31536000, immutable
/docs/assets/stylesheets/*
  Cache-Control: public, max-age=31536000, immutable
