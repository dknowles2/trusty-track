{
    "name": "frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=22.22.2"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "codegen": "cd .. && uv run python scripts/export_schema.py && cd frontend && graphql-codegen --config codegen.ts",
        "codegen:check": "npm run codegen && git diff --exit-code -- schema.graphql src/gql",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "test": "vitest",
        "test:e2e": "playwright test",
        "test:docs": "playwright test --config=playwright.screenshots.config.ts",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@mdi/js": "^7.4.47",
        "@mdi/react": "^1.6.1",
        "@urql/exchange-graphcache": "^9.0.1",
        "graphql": "^16.12.0",
        "graphql-ws": "^6.2.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-router-dom": "^7.18.3",
        "recharts": "^3.10.1",
        "urql": "^5.0.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@graphql-codegen/cli": "^7.3.1",
        "@graphql-codegen/import-types-preset": "^4.0.1",
        "@graphql-codegen/typescript": "^6.1.0",
        "@graphql-codegen/typescript-operations": "^6.1.2",
        "@playwright/test": "^1.62.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.6",
        "@types/node": "^26.4.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@typescript-eslint/eslint-plugin": "^8.68.0",
        "@typescript-eslint/parser": "^8.68.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.9.1",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "^0.5.5",
        "globals": "^17.11.0",
        "jsdom": "^30.0.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.68.0",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "overrides": {
        "minimatch": "^10.2.1"
    }
}
