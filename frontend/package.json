{
    "name": "frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "codegen": "cd .. && uv run python scripts/export_schema.py && cd frontend && graphql-codegen --config codegen.ts",
        "codegen:check": "npm run codegen && git diff --exit-code -- schema.graphql src/gql",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "test": "vitest",
        "test:e2e": "playwright test",
        "test:docs": "playwright test --config=playwright.screenshots.config.ts"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@mdi/js": "^7.4.47",
        "@mdi/react": "^1.6.1",
        "@urql/exchange-graphcache": "^9.0.1",
        "graphql": "^16.12.0",
        "graphql-ws": "^6.0.7",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-router-dom": "^7.13.1",
        "recharts": "^3.7.0",
        "urql": "^5.0.1"
    },
    "devDependencies": {
        "@graphql-codegen/cli": "^7.2.0",
        "@graphql-codegen/import-types-preset": "^4.0.1",
        "@graphql-codegen/typescript": "^6.1.0",
        "@graphql-codegen/typescript-operations": "^6.1.2",
        "@playwright/test": "^1.58.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^25.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@typescript-eslint/eslint-plugin": "^8.56.1",
        "@typescript-eslint/parser": "^8.56.1",
        "@vitejs/plugin-react": "^5.1.4",
        "eslint": "^9.39.3",
        "eslint-plugin-react-hooks": "7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.3.0",
        "jsdom": "^27.4.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1",
        "vite": "^7.3.1",
        "vitest": "^4.0.18"
    },
    "overrides": {
        "minimatch": "^10.2.1"
    }
}
