# --- Backend Configuration ---

# Directory where data (database, uploads) is stored.
# Defaults to ~/.trustytrack
# TRUSTYTRACK_DATA_DIR=~/.trustytrack

# SQLAlchemy database URL.
# Defaults to sqlite:///~/.trustytrack/trusty-track.db
# TRUSTYTRACK_DB_URL=sqlite:////absolute/path/to/trusty-track.db

# Port for the backend server (used in dev and packaging).
# PORT=8005


# --- Frontend / Development Configuration ---

# URL of the backend server for proxying during development.
# Defaults to http://localhost:8005
# VITE_BACKEND_URL=https://localhost:8005

# Whether to verify SSL certificates for the backend proxy during development.
# Set to 'true' if using valid certificates, 'false' for self-signed.
# VITE_BACKEND_SECURE=false

# Whether to start the frontend dev server in HTTPS mode ('true' or 'false').
# HTTPS_SERVER=true


# --- Testing Configuration ---

# Set to true in CI environments to optimize test runner behavior.
# CI=false
